# QA Farm — configuração do server01. Copiado para .env pelo scripts/ops/install.sh (chmod 600).
# Nunca versionar o .env.

# acesso ao painel
QAFARM_PASSWORD=troque-esta-senha
QAFARM_SECRET=troque-este-segredo-hex-64
PORT=3000

# pastas
QAFARM_DATA_DIR=/home/server01/qa-farm-data
QAFARM_ROBOT_PROJECT=/home/server01/www/QA_Automacao_APP
QAFARM_ROBOT_BIN=/home/server01/www/QA_Automacao_APP/.venv/bin/robot
QAFARM_PYTHON_BIN=/home/server01/www/QA_Automacao_APP/.venv/bin/python
QAFARM_FARM_HOME=/home/server01/android-farm

# ferramentas
ANDROID_SDK_ROOT=/home/server01/android-sdk
JAVA_HOME=/home/server01/jdk
QAFARM_AAPT2=/home/server01/android-sdk/build-tools/37.0.0/aapt2
QAFARM_ADB_BIN=/home/server01/android-sdk/platform-tools/adb
QAFARM_APPIUM_BIN=/home/server01/node/bin/appium

# execução
QAFARM_APPIUM_BASE_PORT=4800
QAFARM_DEVICES_PER_APPIUM=5
QAFARM_MAX_DEVICES=18
QAFARM_INSTALL_CONCURRENCY=5
QAFARM_FAKE=0
