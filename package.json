{
  "name": "qa-farm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:runner": "tsx watch src/runner/main.ts",
    "dev:fake": "node scripts/dev-fake.mjs",
    "build": "next build && npm run build:runner",
    "build:runner": "tsup",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "start:runner": "node dist/runner.mjs",
    "lint": "eslint && node scripts/check-aaa.mjs && python3 scripts/check_aaa.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": "python3 -m pytest scripts/robot/tests -m \"not server\" -q",
    "test:e2e": "playwright test",
    "check-aaa": "node scripts/check-aaa.mjs && python3 scripts/check_aaa.py",
    "check-overlap": "tsx scripts/ops/check-overlap.ts",
    "pick-cases": "tsx scripts/ops/pick-cases.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.47.0",
    "next": "15.5.26",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
